# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Option 1: Individual parameters)
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fintech_db
DB_SSL=false

# Database Configuration (Option 2: Connection String - overrides option 1 if provided)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fintech_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=24h
